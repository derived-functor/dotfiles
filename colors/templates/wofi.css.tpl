*:selected {
    background: transparent;
}

window {
  background-color: ${COLOR_BG};
}

* {
  font-family: "Jetbrains Mono";
  color: ${COLOR_FG};
}

#scroll {
  padding: 0.5rem;
}

#input {
  background-color: ${COLOR_SURFACE};
  color: ${COLOR_FG};
  outline: none;
  box-shadow: none;
  border: 0.5px solid ${COLOR_BORDER};
  border-radius: 0rem;
  font-size: 1rem;
  padding: 0.5rem;
}

#inner-box {
  margin: 0.5rem;
  font-size: 1rem;
}

#img {
  margin: 10px 10px;
}

#entry {
  border-radius: 0rem;
}

#entry:selected {
  background-color: ${COLOR_ACCENT};
  outline: none;
}

#text:selected {
  color: ${COLOR_BG};
}

