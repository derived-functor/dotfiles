{
    "": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
        "logo": {
            "type": "kitty",
            "source": "/home/mreblan/.config/fastfetch/logo.png",
            "width": 30,
            "padding": {
                "top": 5,
                "left": 2
            }
        },
        "key": {
            "width": 17
        },
        "display": {
            "separator": " || ",
            "color": {
                "title": "#81a1c1",
                "keys": "#8fbcbb"
            }
        },
        "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}@{host-name-colored}"
        },
        {
            "type": "separator",
            "string": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        },
        {
            "type": "os",
            "key": "󰣇 OS ",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "host",
            "key": "󰌢 HT ",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "kernel",
            "key": " KR ",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "shell",
            "key": " SH ",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "wm",
            "key": " WM ",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "terminal",
            "key": " TR ",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "cpu",
            "key": " CP ",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "gpu",
            "key": "󰢮 GP ",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "memory",
            "key": " RAM",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "disk",
            "key": "  / ",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        "break",
        {
            "type": "colors",
            "symbol": "square"
        }
    ]
}

